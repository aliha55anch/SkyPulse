# Geocoding API - city name to coordinates (Open-Meteo, free)
VITE_GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search

# Weather forecast API (Open-Meteo, free)
VITE_FORECAST_API_URL=https://api.open-meteo.com/v1/forecast

# Reverse geocoding - coordinates to city name (OpenStreetMap, free)
VITE_NOMINATIM_API_URL=https://nominatim.openstreetmap.org/reverse

# Map tile imagery (OpenStreetMap, free)
VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
